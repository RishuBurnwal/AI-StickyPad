# Sticky Notes — AI keys (template). Copy to .env and fill in.
# .env is git-ignored; .env.example is safe to commit (no secrets).
#
# Multiple keys per provider: NAME, NAME_2, NAME_3 ...
# The app rotates to the next key when one hits a rate limit.

GEMINI_API_KEY=
# GEMINI_API_KEY_2=

GROQ_API_KEY=
# GROQ_API_KEY_2=

NVIDIA_API_KEY=
# NVIDIA_API_KEY_2=

# Optional providers
# OPENAI_API_KEY=
# PERPLEXITY_API_KEY=
